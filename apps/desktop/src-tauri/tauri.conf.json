{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trufi Cleaner",
  "version": "0.1.0",
  "identifier": "app.trufi.cleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trufi Cleaner",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Trufi Cleaner"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Trufi",
    "shortDescription": "Очистка и оптимизация ПК"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3NTBBNEI1QkJEMThEMjEKUldRaGpkRzd0YVJReHdaOGRKL2hlZEVBbTZSMThJV3E2SG1ML05HZ2ZKZ0pEc05HRFB3YXpHcE8K",
      "endpoints": [
        "https://github.com/JmeTruffle/Trufi-Cleaner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
