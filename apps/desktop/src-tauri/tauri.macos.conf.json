{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trufi Cleaner",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": { "x": 18, "y": 13 },
        "transparent": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#4a72d4"
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
